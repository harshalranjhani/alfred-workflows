{
  "bundleid": "local.harshal.trellis-pr-review.panel",
  "variables": {
    "selected_pr": "",
    "thread_url": "",
    "report": "",
    "review_action": [
      {
        "type": "json",
        "src": {
          "pulse": {
            "interval": 0
          },
          "update": {
            "ids": {
              "pr": {
                "enabled": false
              },
              "review": {
                "enabled": false
              },
              "rereview": {
                "enabled": false
              },
              "status": {
                "text": "Preparing review…"
              },
              "history": {
                "enabled": false
              }
            }
          }
        }
      },
      {
        "type": "script",
        "src": "review.py",
        "args": [
          "review",
          "{value:pr.text}"
        ],
        "async": true
      }
    ],
    "rereview_action": [
      {
        "type": "json",
        "src": {
          "pulse": {
            "interval": 0
          },
          "update": {
            "ids": {
              "pr": {
                "enabled": false
              },
              "review": {
                "enabled": false
              },
              "rereview": {
                "enabled": false
              },
              "status": {
                "text": "Preparing review…"
              },
              "history": {
                "enabled": false
              }
            }
          }
        }
      },
      {
        "type": "script",
        "src": "review.py",
        "args": [
          "rereview",
          "{value:pr.text}"
        ],
        "async": true
      }
    ],
    "selected_round": ""
  },
  "pulse": {
    "interval": 0,
    "intervalmode": "delay",
    "src": "review.py",
    "args": [
      "poll",
      "{var:selected_pr}",
      "{var:selected_round}"
    ]
  },
  "window": {
    "title": "PR Review",
    "size": {
      "width": 890,
      "height": 600
    },
    "root": {
      "type": "view",
      "layout": "border",
      "padding": 16,
      "spacing": 13,
      "events": [
        {
          "triggers": "preload",
          "action": {
            "type": "script",
            "src": "review.py",
            "args": [
              "init",
              "{var:review_selection}",
              "{var:keyword_pr}"
            ]
          }
        },
        {
          "triggers": "launched",
          "action": {
            "type": "script",
            "src": "review.py",
            "args": [
              "auto",
              "{var:review_selection}"
            ],
            "async": true
          }
        }
      ],
      "components": [
        {
          "type": "view",
          "layout": "border",
          "components": [
            {
              "type": "view",
              "layout": "border",
              "components": [
                {
                  "type": "view",
                  "layout": "inline",
                  "direction": "horizontal",
                  "spacing": 9,
                  "components": [
                    {
                      "type": "imageview",
                      "image": {
                        "type": "file",
                        "src": "../icon.png"
                      },
                      "constraints": {
                        "size": {
                          "width": 42,
                          "height": 42
                        }
                      }
                    },
                    {
                      "type": "view",
                      "layout": "inline",
                      "direction": "vertical",
                      "spacing": 2,
                      "components": [
                        {
                          "type": "label",
                          "text": "PR Review",
                          "font": {
                            "size": 23,
                            "weight": "semibold"
                          }
                        },
                        {
                          "type": "label",
                          "text": "",
                          "font": {
                            "size": 12
                          },
                          "id": "repository",
                          "colour": "secondaryLabelColor"
                        }
                      ]
                    }
                  ],
                  "constraints": {
                    "region": "left"
                  }
                },
                {
                  "type": "label",
                  "text": "Codex · GPT-6.2 Sol · High",
                  "colour": "secondaryLabelColor",
                  "font": {
                    "size": 11
                  },
                  "constraints": {
                    "region": "right",
                    "position": "right"
                  }
                }
              ],
              "constraints": {
                "region": "top"
              }
            },
            {
              "type": "view",
              "layout": "flex",
              "cols": 3,
              "rows": 1,
              "spacing": 9,
              "components": [
                {
                  "type": "template",
                  "src": "stat",
                  "params": {
                    "count": "countPrs",
                    "caption": "PRs reviewed"
                  },
                  "constraints": {
                    "grid": {
                      "row": 0,
                      "col": 0,
                      "colweight": 1
                    }
                  }
                },
                {
                  "type": "template",
                  "src": "stat",
                  "params": {
                    "count": "countRounds",
                    "caption": "Rounds completed"
                  },
                  "constraints": {
                    "grid": {
                      "row": 0,
                      "col": 1,
                      "colweight": 1
                    }
                  }
                },
                {
                  "type": "template",
                  "src": "stat",
                  "params": {
                    "count": "countRereviews",
                    "caption": "Re-reviews completed"
                  },
                  "constraints": {
                    "grid": {
                      "row": 0,
                      "col": 2,
                      "colweight": 1
                    }
                  }
                }
              ],
              "constraints": {
                "region": "bottom"
              }
            }
          ],
          "spacing": 10,
          "constraints": {
            "region": "top"
          }
        },
        {
          "type": "view",
          "layout": "border",
          "components": [
            {
              "type": "view",
              "layout": "border",
              "components": [
                {
                  "type": "view",
                  "layout": "inline",
                  "direction": "vertical",
                  "spacing": 8,
                  "components": [
                    {
                      "type": "label",
                      "text": "History",
                      "font": {
                        "size": 15,
                        "weight": "semibold"
                      }
                    },
                    {
                      "type": "textfield",
                      "id": "historySearch",
                      "placeholder": "Filter by PR or title",
                      "constraints": {
                        "stretch": "horizontal"
                      },
                      "events": [
                        {
                          "triggers": "changed",
                          "action": {
                            "type": "function",
                            "src": "history",
                            "args": "filterdata"
                          }
                        }
                      ]
                    }
                  ],
                  "constraints": {
                    "region": "top"
                  }
                },
                {
                  "type": "dataview",
                  "id": "history",
                  "placeholder": "No review rounds",
                  "spacing": 4,
                  "behaviour": {
                    "selection": {
                      "allowempty": true,
                      "wrap": "vertical"
                    }
                  },
                  "cell": {
                    "height": 52,
                    "root": {
                      "type": "view",
                      "layout": "inline",
                      "direction": "vertical",
                      "spacing": 4,
                      "components": [
                        {
                          "type": "label",
                          "text": "",
                          "font": {
                            "size": 13,
                            "weight": "semibold"
                          },
                          "id": "historyTitle",
                          "constraints": {
                            "stretch": "horizontal"
                          }
                        },
                        {
                          "type": "label",
                          "text": "",
                          "font": {
                            "size": 11
                          },
                          "id": "historyMeta",
                          "colour": "secondaryLabelColor",
                          "constraints": {
                            "stretch": "horizontal"
                          }
                        }
                      ],
                      "id": "historyCell",
                      "padding": 8,
                      "cornerradius": 7
                    },
                    "init": {
                      "historyCell.background": null,
                      "historyTitle.colour": "labelColor",
                      "historyMeta.colour": "secondaryLabelColor"
                    },
                    "selected": {
                      "historyCell.background": "alfredSelectedResultBackgroundColor",
                      "historyTitle.colour": "alfredSelectedResultTextColor",
                      "historyMeta.colour": "alfredSelectedResultTextColor"
                    }
                  },
                  "data": {
                    "type": "basic",
                    "src": [],
                    "filter": {
                      "type": "basic",
                      "args": [
                        "historyTitle.text",
                        "historyMeta.text",
                        "title"
                      ],
                      "match": "{value:historySearch.text}"
                    }
                  },
                  "events": [
                    {
                      "triggers": "changed",
                      "action": {
                        "type": "script",
                        "src": "review.py",
                        "args": [
                          "history",
                          "{value:self.selected.uid}",
                          "{var:selected_round}"
                        ]
                      }
                    }
                  ],
                  "constraints": {
                    "region": "centre"
                  }
                }
              ],
              "spacing": 8,
              "padding": 11,
              "cornerradius": 13,
              "background": {
                "light": "#637E8512",
                "dark": "#B4D6DF12"
              },
              "constraints": {
                "region": "left",
                "size": {
                  "width": 236
                }
              }
            },
            {
              "type": "view",
              "layout": "border",
              "components": [
                {
                  "type": "view",
                  "layout": "inline",
                  "direction": "vertical",
                  "spacing": 9,
                  "components": [
                    {
                      "type": "label",
                      "text": "Select a pull request",
                      "font": {
                        "size": 19,
                        "weight": "semibold"
                      },
                      "id": "detailTitle",
                      "constraints": {
                        "stretch": "horizontal"
                      }
                    },
                    {
                      "type": "textfield",
                      "id": "pr",
                      "placeholder": "PR number or GitHub URL",
                      "focus": true,
                      "constraints": {
                        "stretch": "horizontal"
                      },
                      "events": [
                        {
                          "triggers": "typingstopped",
                          "action": {
                            "type": "script",
                            "src": "review.py",
                            "args": [
                              "select",
                              "{value:pr.text}"
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "type": "view",
                      "layout": "inline",
                      "direction": "horizontal",
                      "spacing": 8,
                      "components": [
                        {
                          "type": "button",
                          "id": "review",
                          "text": "Review",
                          "shortcut": "⌘↩",
                          "tooltip": "Review and post important findings · ⌘↩",
                          "enabled": false,
                          "events": [
                            {
                              "triggers": "actioned",
                              "action": "{var:review_action}"
                            }
                          ]
                        },
                        {
                          "type": "button",
                          "id": "rereview",
                          "text": "Re-review",
                          "shortcut": "⌘⇧↩",
                          "tooltip": "Re-review in the same thread · ⌘⇧↩",
                          "enabled": false,
                          "events": [
                            {
                              "triggers": "actioned",
                              "action": "{var:rereview_action}"
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "constraints": {
                    "region": "top"
                  }
                },
                {
                  "type": "view",
                  "layout": "border",
                  "components": [
                    {
                      "type": "markdownarea",
                      "id": "findings",
                      "constraints": {
                        "region": "centre"
                      },
                      "background": null,
                      "autoadjustcontentinsets": false,
                      "behaviour": {
                        "mode": "replace",
                        "scroll": "start"
                      }
                    }
                  ],
                  "padding": 8,
                  "cornerradius": 12,
                  "background": {
                    "light": "#637E8512",
                    "dark": "#B4D6DF12"
                  },
                  "constraints": {
                    "region": "centre"
                  }
                },
                {
                  "type": "view",
                  "layout": "border",
                  "components": [
                    {
                      "type": "label",
                      "id": "status",
                      "text": "",
                      "colour": "secondaryLabelColor",
                      "font": {
                        "size": 12
                      },
                      "constraints": {
                        "region": "centre"
                      }
                    },
                    {
                      "type": "view",
                      "layout": "inline",
                      "direction": "horizontal",
                      "padding": 0,
                      "spacing": 8,
                      "constraints": {
                        "region": "right"
                      },
                      "components": [
                        {
                          "type": "button",
                          "id": "copy",
                          "text": "Copy",
                          "shortcut": "⌘⇧C",
                          "tooltip": "Copy findings · ⌘⇧C",
                          "enabled": false,
                          "events": [
                            {
                              "triggers": "actioned",
                              "action": {
                                "type": "json",
                                "src": {
                                  "copy": {
                                    "type": "text",
                                    "src": "{var:report}"
                                  }
                                }
                              }
                            }
                          ]
                        },
                        {
                          "type": "button",
                          "id": "open",
                          "text": "Open in T3",
                          "shortcut": "⌘O",
                          "tooltip": "Open the review thread · ⌘O",
                          "enabled": false,
                          "events": [
                            {
                              "triggers": "actioned",
                              "action": {
                                "type": "json",
                                "src": {
                                  "open": {
                                    "type": "url",
                                    "src": "{var:thread_url}"
                                  }
                                }
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "spacing": 8,
                  "constraints": {
                    "region": "bottom"
                  }
                }
              ],
              "spacing": 12,
              "constraints": {
                "region": "centre"
              }
            }
          ],
          "spacing": 14,
          "constraints": {
            "region": "centre"
          }
        }
      ]
    }
  },
  "variablesconfig": {
    "review_selection": {
      "src": "variable",
      "default": "",
      "scriptenv": false
    },
    "review_repository": {
      "src": "variable",
      "default": "",
      "scriptenv": true
    },
    "review_project": {
      "src": "variable",
      "default": "",
      "scriptenv": true
    },
    "review_documents": {
      "src": "variable",
      "default": "",
      "scriptenv": true
    },
    "keyword_pr": {
      "src": "args[0]",
      "default": ""
    }
  },
  "templates": {
    "stat": {
      "type": "view",
      "layout": "inline",
      "direction": "vertical",
      "spacing": 3,
      "components": [
        {
          "type": "label",
          "text": "0",
          "font": {
            "size": 24,
            "weight": "semibold"
          },
          "id": "{param:count}"
        },
        {
          "type": "label",
          "text": "{param:caption}",
          "font": {
            "size": 11
          },
          "colour": "secondaryLabelColor"
        }
      ],
      "padding": 10,
      "background": {
        "light": "#2C888915",
        "dark": "#6BE1D517"
      },
      "cornerradius": 11
    }
  }
}
